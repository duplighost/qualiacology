"phrases":[[10.36,11.6,"The"],[14.14,19.94,"ceiling hums its hollow hymns To no one in particular"],[19.94,27.18,"I'm standing where the frozen dinners live Reading ingredients like scripture"],[27.18,34.02,"There's a man in aisle three crying next to the canned corn"],[34.02,40.68,"And I pretend I didn't see because that's how we're born"],[40.68,45.8,"We learn to look away from everything that's true"],[45.8,53.38,"We practice being strangers till we don't know what else to do"],[54.52,61,"But I see you in the grocery store at 2 a.m."],[61.54,63.98,"Buying things you don't need"],[63.98,67.26,"Just to feel like you ever planned"],[68.56,75.2,"I see you with your card half empty heart half full"],[75.2,77.96,"Wondering if anyone would notice"],[77.96,81.36,"If you stopped showing up at all"],[81.36,81.54,"Yeah,"],[82.34,85.62,"I see you"],[87.12,90.78,"The check-out girl has tired eyes"],[90.78,94.4,"She's been here since the morning shift"],[94.4,97,"She asks me paper or plastic"],[97,100.36,"Like it's a philosophical gift"],[100.96,104.08,"I say plastic, hate myself"],[104.08,107.18,"Paper wouldn't change a thing"],[107.18,113.88,"We're all just choosing containers for the nothing that we bring"],[113.88,120.42,"We fill our arms with objects to keep from feeling bare"],[120.42,126.46,"We call it running errands when we're running from despair"],[128.14,134.88,"But I see you in the grocery store at 2 a.m."],[135.5,141.26,"Buying things you don't need just to feel like you have a plan"],[142.02,149,"And I see you with your card half empty, heart half full"],[149,151.6,"Wondering if anyone would notice"],[151.6,155.82,"If you stop showing up at all"],[156.6,160.06,"And maybe God is just a night manager"],[160.06,162.68,"Watching on the black and white screen"],[162.68,165.02,"Hoping we figure out"],[165.6,169,"What all this produce means"],[169.6,172.36,"And maybe love is just standing"],[172.36,175.08,"In the same hollow glow"],[175.6,178.24,"Saying nothing, needing nothing"],[178.24,181.78,"Except for someone else to know"],[181.78,185.54,"That I see you"],[185.54,188.3,"Yeah, I really fucking see you"],[188.3,191.74,"In the grocery store at 2 a.m."],[192.16,194.26,"Still alive, still trying"],[194.26,196.32,"Still pretending you're okay"],[196.32,198.56,"I see you"],[199.24,202.5,"I see you"],[202.5,207.58,"I see you"],[222.4,229.88,"The automatic doors slide open Crawl there from the parking lot"],[229.88,235.74,"I walk out with my plastic bag holding everything I've got"],[235.74,238.72,"Which isn't much"],[238.72,241.76,"But it's enough"],[241.76,246.54,"To make it through another night"],[262.9,265.54,"Swab fluorescent lights are humming hymns,"],[266.56,270.78,"the ceiling hums its hollow hymns,"],[271.28,271.54,"keeps"],[271.54,273.86,"the alliteration matches the syllable stress,"],[275.58,278.46,"hollow does more emotional work than"],[278.46,280.92,"fluorescent ever could, the hum becomes the subject,"],[282.98,283.96,"disembodied, eerie,"],[285.4,287.04,"like the"],[287.04,287.96,"itself is grieving."]]
}
