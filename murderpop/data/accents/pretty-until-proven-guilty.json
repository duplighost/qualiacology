"phrases":[[0,1.56,"Order in the court."],[2.44,3.3,"Try not to cry."],[30,31.22,"Guess I lean on your wasted youth"],[31.22,32.82,"Switchblade, when I cut the silence clean"],[32.82,34.4,"One, two, fuck you, you know what I mean?"],[34.48,36.5,"Pretty until proven guilty"],[36.5,39.74,"Skirt too short for the courthouse, yeah, that's me"],[39.74,42.52,"Smile, carkeen as a switchblade decree"],[42.52,45.74,"Self-worships the charge, baby, lock me in"],[45.74,48.94,"If love in my chaos is a felony"],[48.94,50.34,"Throw away the key"],[52.02,54,"Pretty, pretty, pretty"],[55.02,56.14,"Get okay!"],[58.74,64.6,"Read me my rights, Mirandize my myth Grand theft hoodie, got receipts for every"],[64.6,68.1,"gift Your new girl stalking, your rebound's a bore"],[68.1,71.3,"Their livestreaming meltdown's from the witness floor"],[71.3,74.46,"You say I broke your heart, where's the corpus delicte?"],[74.58,77.76,"I left you obsessed, that's the only offense that sticks by me"],[77.76,80.9,"Caught red-handed at the after party, seen wearing your jacket painting the townie"],[80.9,82.44,"World's unnoticed, I'm the glitch in your game"],[82.44,83.94,"Crime of the century, owning my name"],[83.94,86.06,"Pretty until proven guilty"],[86.06,89.3,"Skirt too short for the courthouse, yeah, that's me"],[89.3,92.1,"Smile, carve, keen as a switchblade decree"],[92.1,94.9,"If ruining your life is a felony"],[95.44,98.22,"Lock me up, swallow the key"],[98.22,100.08,"Pretty, pretty, pretty"],[101.4,102.56,"Pretty, pretty,"],[103.36,104.52,"pretty"],[104.52,105.86,"Guilt play"],[105.86,107.92,"Click those cuffs tight"],[107.92,109.54,"Let the cold bite deep"],[109.54,112.3,"Maybe I'm guilty, but I look good in these"],[112.3,115.54,"My lawyer is my mirror, says I'm doing fine"],[115.54,120.38,"I'll take the sentence late, I change my mind"],[121.06,122.78,"I said I'm always right"],[124.68,125.86,"I'm always right"],[127.56,128.44,"Pretty"],[129.3,132.04,"Pretty, guilty, pretty, guilty"],[132.04,134.62,"Pretty, pretty, pretty guilty"],[138.1,140.24,"Pretty until proven guilty"],[140.24,144.82,"Skirt high tie, smile like a switch, blade spree, cups as couture"],[144.82,149,"That's my decree, if self-love is a crime against humanity"],[149,152.2,"I'm guilty in the first decree"],[152.74,154.28,"Pretty, pretty, pretty"],[155.66,156.74,"Pretty, pretty,"],[158.32,160.02,"Case closed!"],[160.3,161.32,"Case closed"],[161.32,163.18,"Lipstick stays on"],[163.86,164.8,"You're welcome"]]
