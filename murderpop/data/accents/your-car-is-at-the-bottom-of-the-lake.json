"phrases":[[0,2,"You should've let me drive"],[3.76,8.28,"Last Tuesday, you called me unstable and scary"],[9.26,11.16,"Said you needed space,"],[11.74,14.38,"said I was too much to carry"],[15,19.84,"Packed your bags with shaking hands, grabbed your keys from the rack"],[21.44,25.96,"Told me it was over, said you weren't coming back"],[25.96,29.38,"You peeled out the driveway in your rearview mirror moment"],[29.38,31.94,"Wheels on gravel screaming like you meant it"],[31.94,35.6,"But I'm a problem solver baby, I think two steps ahead"],[35.6,38.44,"So I solved this little issue while you slept"],[39.98,41.4,"By the way"],[41.4,44.28,"Your car is at the bottom of the lake"],[44.28,47.4,"Suitcase, mixtape, every choice you thought you'd make"],[47.4,50.36,"Yeah, your car is at the bottom of the lake"],[50.36,53.1,"And you're never gonna leave me, not for heaven's sake"],[53.84,56.74,"Police came knocking with your photo and the questions"],[56.74,59.68,"I poured them coffee, performed my best confessions"],[59.68,62.4,"He went for cigarettes, I cried right on cue"],[62.4,65.54,"They said I'll turn up, ma'am, I said, God, I hope it's true"],[66.14,68.3,"The water's so dark down there"],[68.68,71.74,"Fifty feet of secrets and I don't care"],[71.74,74.6,"You love that stick shift, guess you should've taught me"],[74.6,78.74,"I just put it in neutral, let gravity take what you wouldn't give me"],[78.74,83.52,"Oh, by the way, your car's at the bottom of the lake"],[83.52,86.7,"Windows down, water black, every promise that you break"],[86.7,89.66,"Yeah, your car's at the bottom of the lake"],[89.66,94.54,"And you're never gonna leave me, not for heaven's sake"],[96.94,100.04,"You're mine forever now"],[100.04,103.18,"Make no mistake"],[104.52,106.8,"Don't worry, baby"],[106.8,110.22,"I kept the spare key"],[110.22,113.72,"Just in case"],[113.72,117.66,"You wanna come home"]]
}
